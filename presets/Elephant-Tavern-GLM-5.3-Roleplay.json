            {
                "id": "b1c2d3e4-0001-4000-8000-000000000001",
                "scriptName": "Strip VTK from Sent Context",
                "findRegex": "/<!-- VTK_START -->[\\s\\S]*?<!-- VTK_END -->/gi",
                "replaceString": "",
                "trimStrings": [],
                "placement": [
                    2
                ],
                "disabled": false,
                "markdownOnly": false,
                "promptOnly": true,
                "runOnEdit": false,
                "substituteRegex": 0,
                "minDepth": 3,
                "maxDepth": null
            },
            {
                "id": "2b216375-774b-47ec-9308-7f68ffe93b34",
                "scriptName": "Anti-slop: barely above a whisper → quietly",
                "findRegex": "/,?\\s*(?:in a (?:voice|tone)|(?:his|her|their|my) voice)\\s+barely above a whisper/gi",
                "replaceString": " quietly",
                "placement": [
                    2
                ],
                "disabled": false,
                "markdownOnly": true,
                "promptOnly": true,
                "runOnEdit": true,
                "substituteRegex": 0,
                "minDepth": null,
                "maxDepth": null,
                "trimStrings": []
            },
            {
                "id": "9ed2f964-82a8-40ad-9146-79d9b6c8c003",
                "scriptName": "Anti-slop: drop 'for a (long) moment/beat'",
                "findRegex": "/\\s+for a (?:long )?(?:moment|beat)(?=[.,;!?])/gi",
                "replaceString": "",
                "placement": [
                    2
                ],
                "disabled": false,
                "markdownOnly": true,
                "promptOnly": true,
                "runOnEdit": true,
                "substituteRegex": 0,
                "minDepth": null,
                "maxDepth": null,
                "trimStrings": []
            },
            {
                "id": "290c1ca8-aec3-4781-8ed1-ffa63f54b8e2",
                "scriptName": "Anti-slop: drop cliché narration sentences",
                "findRegex": "/(?<=^|[.!?][\\\"\\u201d]?\\s+|\\n)[^.!?\\n\\\"<>]*\\b(?:shivers? (?:runs?|ran|went|goes) down (?:his|her|their|my) spine|(?:hangs?|hung) heavy in the air|words? (?:hangs?|hung) in the air|a mix(?:ture)? of \\w+ and \\w+|something primal)\\b[^.!?\\n\\\"<>]*[.!?](?:\\s+|$)/gi",
                "replaceString": "",
                "placement": [
                    2
                ],
                "disabled": false,
